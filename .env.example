# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nexus?retryWrites=true&w=majority

# Project salt for hashing raw MAC addresses (long random 64-char hex string, never change after launch)
DEVICE_SALT=replace_with_a_long_random_hex_string_32_or_64_chars

# Optional: if set, clients and admin must send header x-api-key: <value>
API_KEY=

# Day boundary timezone offset in minutes (India = 330, UTC = 0)
TZ_OFFSET_MINUTES=330

# Savings assumptions
PETROL_KM_PER_LITER=45
PETROL_PRICE_INR=102
PETROL_CO2_KG_PER_LITER=2.31
EV_CO2_KG_PER_KM=0.011

# Vercel app domain or localhost
DOMAIN=https://your-app-name.vercel.app

# ==============================================================================
# AI PROVIDERS CONFIGURATION (Free & Configurable Swapping)
# ==============================================================================
# Active provider: 'auto' (recommended - auto-cascades to next available free key),
# or specify directly: 'groq', 'mistral', 'nvidia', 'google', 'openrouter', 'cohere', 'ollama', 'fallback'
ACTIVE_AI_PROVIDER=auto

# 1. Groq (Ultra-fast Llama 3.3 70B & 8B, generous free tier: https://console.groq.com)
GROQ_API_KEY=

# 2. Mistral AI (Mistral Small / Open Mistral, free tier: https://console.mistral.ai)
MISTRAL_API_KEY=

# 3. NVIDIA NIM (Free API credits for Llama 3.3 70B & Mistral Large: https://build.nvidia.com)
NVIDIA_API_KEY=

# 4. Google AI / Gemini (Gemini 2.0 Flash / 1.5 Flash free tier: https://aistudio.google.com)
GEMINI_API_KEY=

# 5. OpenRouter (Suggested bonus free provider with :free models: https://openrouter.ai)
OPENROUTER_API_KEY=

# 6. Cohere (Optional: https://cohere.com)
COHERE_API_KEY=

# 7. Local Ollama (Optional offline zero-cost inference: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
