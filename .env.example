# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nexus?retryWrites=true&w=majority

# Project salt for hashing raw MAC addresses (long random 64-char hex string, never change after launch)
DEVICE_SALT=replace_with_a_long_random_hex_string_32_or_64_chars

# Optional: if set, clients and admin must send header x-api-key: <value>
API_KEY=

# Day boundary timezone offset in minutes (India = 330, UTC = 0)
TZ_OFFSET_MINUTES=330

# Savings assumptions
PETROL_KM_PER_LITER=45
PETROL_PRICE_INR=102
PETROL_CO2_KG_PER_LITER=2.31
EV_CO2_KG_PER_KM=0.011

# Vercel app domain or localhost
DOMAIN=https://your-app-name.vercel.app
